# Clerk — em desenvolvimento pode ficar vazio (modo "keyless": o Clerk cria chaves temporárias).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/inicio
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Banco — vazio usa PGlite local em .data/pglite. Em produção: string do Supabase (pooler).
DATABASE_URL=

# Cloudflare R2 (fotos do check-in). Sem estas variáveis, os arquivos ficam em .data/arquivos (só para desenvolvimento).
# Crie um bucket privado e um token de API do R2 com permissão de leitura e escrita nesse bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Endereço público do app (usado nos links de orçamento enviados ao cliente).
# Sem ele, o link usa o endereço que estiver aberto no navegador.
# APP_URL=https://oficina.seudominio.com.br
