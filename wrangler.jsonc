{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker gerado pelo OpenNext (pnpm cf:build). Não mude main nem assets.
  "name": "oficina-pro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Roda perto do banco (Supabase em São Paulo): o app faz várias consultas por requisição.
  "placement": { "region": "aws:sa-east-1" },

  // Sem --env não há deploy: use `pnpm cf:deploy:homolog` ou `pnpm cf:deploy:prod`.
  // Bindings não são herdados entre ambientes; por isso cada um repete services, images e hyperdrive.
  "workers_dev": false,

  "env": {
    "homolog": {
      "name": "oficina-pro-homolog",
      "routes": [{ "pattern": "hoficina.yagoduarte.com.br", "custom_domain": true }],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "oficina-pro-homolog" }],
      "images": { "binding": "IMAGES" },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          // id impresso por `wrangler hyperdrive create oficina-pro-homolog ...` (docs/deploy.md)
          "id": "7f5ce26fcaa84cb2a6b60a59b2d3ee2b",
          // Só para `wrangler dev`/preview local; sem banco local fica um endereço que não responde.
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
        }
      ],
      "vars": {
        // Públicas (vão para o navegador): o build lê daqui (scripts/cf-build.mjs).
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_cHJvZm91bmQtbXVza294LTM3ODIuY2xlcmsuYWNjb3VudHMuZGV2JA",
        "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
        "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
        "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/inicio",
        "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/onboarding",
        // Termos de uso e Política de privacidade (src/lib/legal.ts)
        "NEXT_PUBLIC_LEGAL_RESPONSAVEL": "Yago Duarte Ribeiro",
        "NEXT_PUBLIC_LEGAL_EMAIL": "contato@yagoduarte.com.br",
        "NEXT_PUBLIC_LEGAL_FORO": "Várzea Paulista/SP",
        "APP_URL": "https://hoficina.yagoduarte.com.br"
      }
    },
    "production": {
      "name": "oficina-pro",
      "routes": [{ "pattern": "oficina.yagoduarte.com.br", "custom_domain": true }],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "oficina-pro" }],
      "images": { "binding": "IMAGES" },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          // id impresso por `wrangler hyperdrive create oficina-pro ...` (docs/deploy.md)
          "id": "7ae166a704e04761b818e70809ef110b",
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
        }
      ],
      "vars": {
        // Públicas (vão para o navegador): o build lê daqui (scripts/cf-build.mjs).
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsueWFnb2R1YXJ0ZS5jb20uYnIk",
        "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
        "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
        "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/inicio",
        "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/onboarding",
        // Termos de uso e Política de privacidade (src/lib/legal.ts)
        "NEXT_PUBLIC_LEGAL_RESPONSAVEL": "Yago Duarte Ribeiro",
        "NEXT_PUBLIC_LEGAL_EMAIL": "contato@yagoduarte.com.br",
        "NEXT_PUBLIC_LEGAL_FORO": "Várzea Paulista/SP",
        "APP_URL": "https://oficina.yagoduarte.com.br"
      }
    }
  }
}
