{
  "name": "oficina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tunel": "cloudflared tunnel run --url http://localhost:3000 oficinapro",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "db:migrate:homolog": "node scripts/migrar.mjs homolog",
    "db:migrate:prod": "node scripts/migrar.mjs prod",
    "cf:build:homolog": "node scripts/cf-build.mjs homolog",
    "cf:build:prod": "node scripts/cf-build.mjs production",
    "cf:preview": "opennextjs-cloudflare preview --env homolog",
    "cf:deploy:homolog": "pnpm db:migrate:homolog && pnpm cf:build:homolog && opennextjs-cloudflare deploy --env homolog --secrets-file .env.secrets.homolog.json",
    "cf:deploy:prod": "pnpm db:migrate:prod && pnpm cf:build:prod && opennextjs-cloudflare deploy --env production --secrets-file .env.secrets.prod.json",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@clerk/localizations": "^4.24.8",
    "@clerk/nextjs": "^7.10.0",
    "@electric-sql/pglite": "^0.5.16",
    "@opennextjs/cloudflare": "^1.20.17",
    "@react-pdf/renderer": "^4.9.0",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "node-forge": "^1.4.3",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.165.0"
  },
  "packageManager": "pnpm@11.0.9"
}
